@model Product
<div class="card product-card h-100">
    <a asp-area="" asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id" class="product-img-link">
        <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Name" loading="lazy" />
        @if (Model.Stock == 0)
        {
            <span class="badge bg-dark position-absolute top-0 start-0 m-2">Rupture</span>
        }
        else if (Model.SalesCount >= 200)
        {
            <span class="badge bg-warning text-dark position-absolute top-0 start-0 m-2">Populaire</span>
        }
    </a>
    <div class="card-body d-flex flex-column">
        <div class="small text-muted mb-1">@Model.Category?.Name</div>
        <h3 class="h6 card-title mb-1">
            <a asp-area="" asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id" class="stretched-link-text">@Model.Name</a>
        </h3>
        <div class="small mb-2"><partial name="_Stars" model="Model.Rating" /> <span class="text-muted">(@Model.SalesCount vendus)</span></div>
        <div class="mt-auto d-flex justify-content-between align-items-center">
            <span class="price">@Model.Price.ToDt()</span>
            <form asp-area="" asp-controller="Cart" asp-action="Add" method="post">
                <input type="hidden" name="productId" value="@Model.Id" />
                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                <button type="submit" class="btn btn-sm btn-brand" disabled="@(Model.Stock == 0)" title="Ajouter au panier">Ajouter</button>
            </form>
        </div>
    </div>
</div>
