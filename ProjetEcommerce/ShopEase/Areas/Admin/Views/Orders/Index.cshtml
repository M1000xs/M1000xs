@model List<Order>
@{
    ViewData["Title"] = "Commandes";
    var current = (OrderStatus?)ViewBag.Status;
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Commandes <span class="text-muted fs-6">(@Model.Count)</span></h1>
    <div class="btn-group btn-group-sm">
        <a asp-action="Index" class="btn btn-outline-secondary @(current is null ? "active" : "")">Toutes</a>
        @foreach (OrderStatus s in Enum.GetValues<OrderStatus>())
        {
            <a asp-action="Index" asp-route-status="@s" class="btn btn-outline-secondary @(current == s ? "active" : "")">@s.DisplayName()</a>
        }
    </div>
</div>
<div class="card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light"><tr><th>N° commande</th><th>Client</th><th>Date</th><th class="text-center">Articles</th><th class="text-end">Total</th><th>Paiement</th><th>Statut</th></tr></thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@o.Id" class="fw-semibold">@o.OrderNumber</a></td>
                        <td>@o.User?.FullName<div class="small text-muted">@o.User?.Email</div></td>
                        <td>@o.OrderDate.ToFrDateTime()</td>
                        <td class="text-center">@o.Items.Sum(i => i.Quantity)</td>
                        <td class="text-end text-nowrap">@o.Total.ToDt()</td>
                        <td>@o.PaymentMethod.DisplayName()</td>
                        <td><span class="badge @o.Status.BadgeClass()">@o.Status.DisplayName()</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
